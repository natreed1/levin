# Copy to messenger/.env (gitignored) for local + testing.
# `python -m messenger` loads messenger/.env and repo-root .env automatically.

# Required for local sessions / encrypting per-user API keys
MESSENGER_SESSION_SECRET=dev-session-secret-change-me
MESSENGER_INVITE_TOKEN=dev-invite-token-change-me

# Preferred frontier provider for local/testing (auto-links on login)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional fallback if OpenRouter is unset
# ANTHROPIC_API_KEY=sk-ant-...
# ANALYST_CLAUDE_MODEL=claude-sonnet-5

# Local launcher defaults (usually left alone)
# MESSENGER_DEV_AUTO_LOGIN=1
# MESSENGER_SCHEDULER=0
